PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Optional additional permitted CORS origin (comma-separated if multiple)
# CLIENT_URL=http://localhost:5174

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/legalconnect
# Optional dedicated isolated test database URI for automated test suites
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/legalconnect_test

JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email Verification (Resend)
# Obtain an API key from https://resend.com/api-keys
# EMAIL_FROM / RESEND_FROM_EMAIL must use a verified domain in production (e.g. "LegalConnect <noreply@yourdomain.com>")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=LegalConnect <onboarding@resend.dev>
RESEND_FROM_EMAIL=LegalConnect <onboarding@resend.dev>

# Mobile OTP Verification (MSG91)
# Obtain from https://control.msg91.com (SMS DLT registration required for Indian telecom compliance)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id
# Optional 6-character registered DLT sender header (e.g. LGLCON)
# MSG91_SENDER_ID=LGLCON

# Cryptographic Pepper & Encryption
# Secret salt for HMAC-SHA256 OTP hashing (resists offline rainbow table attacks)
OTP_PEPPER_SECRET=your_otp_pepper_secret_minimum_32_chars
# Managed 256-bit encryption key for AES-256-GCM client Aadhaar & PAN storage at rest
IDENTITY_ENCRYPTION_KEY=your_identity_aes_encryption_key_32_bytes

# Initial Admin Bootstrap (Used by: npm run seed:admin)
# ADMIN_NAME="Platform Administrator"
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=SecurePassword123!
# ADMIN_PHONE="+91 99999 00000"